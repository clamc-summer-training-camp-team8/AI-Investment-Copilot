{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-investment-copilot/contracts/ai/review_draft.schema.json",
  "title": "ReviewDraft",
  "type": "object",
  "required": ["security_id", "thesis_id", "period_start", "period_end", "summary", "supporting_changes", "conflicting_changes", "open_questions", "citations", "requires_human_review", "model_version", "prompt_version", "generated_at", "ai_status"],
  "additionalProperties": false,
  "properties": {
    "security_id": {"type": "string", "minLength": 1},
    "thesis_id": {"type": "string", "minLength": 1},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "summary": {"type": "string", "minLength": 1},
    "supporting_changes": {"type": "array", "items": {"type": "string"}},
    "conflicting_changes": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+#paragraph-[0-9]+$"}},
    "requires_human_review": {"type": "boolean", "const": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model_version": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "ai_status": {"type": "string", "enum": ["候选", "低置信", "解析失败"]}
  }
}
