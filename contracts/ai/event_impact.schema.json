{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-investment-copilot/contracts/ai/event_impact.schema.json",
  "title": "EventImpactBatch",
  "description": "一个事件对一组候选假设的批量影响分析。每条候选假设必须返回一条结果，包括无关结果。",
  "type": "object",
  "required": [
    "document_id",
    "security_id",
    "event",
    "impacts",
    "model_version",
    "prompt_version",
    "generated_at",
    "ai_status"
  ],
  "additionalProperties": false,
  "properties": {
    "disclaimer": { "type": "string" },
    "document_id": { "type": "string", "minLength": 1 },
    "security_id": { "type": "string", "minLength": 1 },
    "event": {
      "type": "object",
      "required": ["event_type", "disclosure_time", "fact", "evidence_locator"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string" },
        "event_type": {
          "type": "string",
          "enum": ["订单", "政策", "管理层表述", "业绩", "其他"]
        },
        "event_time": { "type": ["string", "null"], "format": "date" },
        "disclosure_time": { "type": "string", "format": "date-time" },
        "fact": {
          "type": "string",
          "minLength": 1,
          "description": "所有候选假设共享的事件事实，与每条影响结果中的 inference 分开。"
        },
        "evidence_locator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+#paragraph-[0-9]+$"
        }
      }
    },
    "impacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hypothesisImpact" }
    },
    "model_version": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "ai_status": {
      "type": "string",
      "enum": ["候选", "低置信", "解析失败"]
    },
    "model_metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "citation": {
      "oneOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9_.-]+#paragraph-[0-9]+$" },
        {
          "type": "object",
          "required": ["locator"],
          "additionalProperties": false,
          "properties": {
            "locator": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+#paragraph-[0-9]+$"
            }
          }
        }
      ]
    },
    "hypothesisImpact": {
      "type": "object",
      "required": [
        "thesis_id",
        "hypothesis_id",
        "relevance",
        "inference",
        "citations",
        "unsupported_claims",
        "signal"
      ],
      "additionalProperties": false,
      "properties": {
        "thesis_id": { "type": "string", "minLength": 1 },
        "hypothesis_id": { "type": "string", "minLength": 1 },
        "relevance": {
          "type": "string",
          "enum": ["相关", "不相关", "待定"]
        },
        "inference": {
          "type": "string",
          "minLength": 1,
          "description": "基于共享事件事实、候选假设和证据形成的推断，不得冒充事实。"
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        },
        "unsupported_claims": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signal": {
          "type": "object",
          "required": [
            "direction",
            "impact_direction",
            "strength",
            "confidence",
            "rationale",
            "transmission_path",
            "suggested_tracking",
            "requires_human_review"
          ],
          "additionalProperties": false,
          "properties": {
            "direction": {
              "type": "string",
              "enum": ["正向", "负向", "中性", "不确定"]
            },
            "impact_direction": {
              "type": "string",
              "enum": ["支持", "冲突", "中性", "无关"]
            },
            "strength": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 1
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "horizon": {
              "type": ["string", "null"],
              "enum": ["短期", "中期", "长期", null]
            },
            "rationale": { "type": "string", "minLength": 1 },
            "transmission_path": { "type": "string", "minLength": 1 },
            "suggested_tracking": {
              "type": "array",
              "items": { "type": "string" }
            },
            "requires_human_review": { "type": "boolean", "const": true }
          }
        }
      }
    }
  }
}
