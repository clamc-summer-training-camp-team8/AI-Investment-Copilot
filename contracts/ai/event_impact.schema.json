{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-investment-copilot/contracts/ai/event_impact.schema.json",
  "title": "EventImpact",
  "description": "事件影响分析输出（PRD 10.2）。方向相对具体假设判断，不做通用正负面替代，不输出买卖建议。字段形状对齐 docs/data/数据分析交付包/业务样例包/样例预期AI输出.json。",
  "type": "object",
  "required": [
    "document_id",
    "security_id",
    "event",
    "signal",
    "model_version",
    "prompt_version",
    "generated_at",
    "ai_status"
  ],
  "additionalProperties": false,
  "properties": {
    "disclaimer": {
      "type": "string",
      "description": "样例数据的虚构声明。真实数据可省略。"
    },
    "document_id": { "type": "string", "minLength": 1 },
    "security_id": { "type": "string", "minLength": 1 },
    "thesis_id": {
      "type": ["string", "null"],
      "description": "召回到的候选逻辑。相关性不足时为 null。"
    },
    "hypothesis_id": {
      "type": ["string", "null"],
      "description": "影响的具体假设。PRD 10.2 要求影响对象具体到假设，不只到公司。"
    },
    "relevance": {
      "type": "string",
      "enum": ["相关", "不相关", "待定"],
      "description": "PRD 10.2 输出项『相关性』。不相关时 signal.direction 应为中性。"
    },
    "citations": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "pattern": "^[A-Za-z0-9_.-]+#paragraph-[0-9]+$"},
          {
            "type": "object",
            "required": ["locator"],
            "additionalProperties": false,
            "properties": {
              "locator": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+#paragraph-[0-9]+$"}
            }
          }
        ]
      },
      "description": "Supporting retrieval locators; they must be present in the input context."
    },
    "unsupported_claims": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Claims not supported by the input evidence."
    },
    "event": {
      "type": "object",
      "required": ["event_type", "disclosure_time", "fact", "evidence_locator"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string" },
        "event_type": {
          "type": "string",
          "enum": ["订单", "政策", "管理层表述", "业绩", "其他"]
        },
        "event_time": {
          "type": ["string", "null"],
          "format": "date",
          "description": "事实发生时间。无法确认时可为空（FLD-006 允许）。"
        },
        "disclosure_time": {
          "type": "string",
          "format": "date-time",
          "description": "首次公开可得时间，必填且必须带时区。为空是阻断级错误（DQ-001）；不允许用入库时间兜底。"
        },
        "fact": {
          "type": "string",
          "minLength": 1,
          "description": "事实陈述，与推断分开（PRD 10.5 第一条）。"
        },
        "inference": {
          "type": "string",
          "description": "模型推断部分。与 fact 分开存放，界面需区分展示。"
        },
        "evidence_locator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+#paragraph-[0-9]+$",
          "description": "必须能在 document_segment 表定位到。格式 {document_id}#paragraph-{n}。"
        }
      }
    },
    "signal": {
      "type": "object",
      "required": ["direction", "confidence", "requires_human_review"],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["正向", "负向", "中性", "不确定"],
          "description": "SignalDirection，与 app/core/enums.py 一致。不是股价方向，也不是通用情绪极性（FLD-007）。"
        },
        "impact_direction": {
          "type": "string",
          "enum": ["支持", "冲突", "中性", "无关"],
          "description": "ImpactDirection：证据相对具体假设的影响方向。与 direction 是两个枚举，不可混用。"
        },
        "strength": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "低于 RuleThresholds.low_confidence_cutoff（默认 0.6）时 ai_status 必须为『低置信』，且不触发重大风险提醒（FR-R-007）。"
        },
        "horizon": {
          "type": ["string", "null"],
          "enum": ["短期", "中期", "长期", null]
        },
        "rationale": { "type": "string" },
        "transmission_path": {
          "type": "string",
          "description": "PRD 10.2 输出项『传导路径』。"
        },
        "suggested_tracking": {
          "type": "array",
          "items": { "type": "string" },
          "description": "PRD 10.2 输出项『建议跟踪项』。是研究提示，不是交易建议。"
        },
        "requires_human_review": {
          "type": "boolean",
          "const": true,
          "description": "恒为 true。AI 输出一律停在候选状态，人工闸门在 app/services（PRD 5.4）。"
        }
      }
    },
    "model_version": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "string", "minLength": 1 },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "必须带时区，且不得早于 event.disclosure_time（DQ-003）。"
    },
    "ai_status": {
      "type": "string",
      "enum": ["候选", "低置信", "解析失败"]
    },
    "model_metadata": {
      "type": "object",
      "description": "样例 JSON 的嵌套形式，与顶层版本字段等价。保留以兼容样例包。",
      "additionalProperties": true
    }
  }
}
