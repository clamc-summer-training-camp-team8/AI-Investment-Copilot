# 复制为 .env 后按本地情况修改。.env 不进 git。

APP_NAME=AI Investment Copilot
ENV=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# 模型网关。
# local = 规则实现，适合离线开发与 CI；使用时把模型版本改为 local-rule-v1。
# http  = OpenAI-compatible Chat Completions；当前示例直接配置 DeepSeek V4 Flash。
LLM_PROVIDER=http
LLM_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL_VERSION=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_THINKING_MODE=disabled
LLM_REASONING_EFFORT=low
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
PROMPT_VERSION=prompts-v1

# 离线排序先验的 GPT 检查员。显式开启后复用服务端 LLM_API_KEY；候选材料会发送
# 到配置的 OpenAI Responses API。默认关闭，不影响现有模型网关。
RANKING_JUDGE_ENABLED=false
RANKING_JUDGE_ENDPOINT=https://api.openai.com/v1/responses
RANKING_JUDGE_MODEL_VERSION=gpt-5.6-terra
RANKING_JUDGE_CANDIDATE_LIMIT=40
RANKING_JUDGE_WEIGHT=0.3

REDIS_URL=redis://127.0.0.1:6379/0
APP_TIMEZONE=Asia/Shanghai

# 今日投资新闻采集（可选）。密钥只填入本地 .env 或部署密钥管理系统，禁止提交。
INVESTODAY_API_KEY=
INVESTODAY_NEWS_ENABLED=false
INVESTODAY_NEWS_BASE_URL=https://data-api.investoday.net/data
INVESTODAY_NEWS_PAGE_SIZE=100
INVESTODAY_NEWS_MAX_ITEMS_PER_RUN=20
INVESTODAY_REPORTS_ENABLED=true
INVESTODAY_REPORTS_PAGE_SIZE=10
INVESTODAY_REPORTS_MAX_ITEMS_PER_RUN=30
# 仅自动采集：暂不维护的公司可写在这里，逗号分隔，例如 300274。
INVESTODAY_EXCLUDED_SECURITY_IDS=300274
UPLOAD_MAX_BYTES=20971520
UPLOAD_RETENTION_DAYS=30
FAILED_UPLOAD_RETENTION_DAYS=90

# S3-compatible immutable source archive (local development uses MinIO).
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_ACCESS_KEY=copilot
OBJECT_STORE_SECRET_KEY=copilot-local-only
OBJECT_STORE_BUCKET=copilot-documents
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SECURE=false
OBJECT_STORE_RETENTION_DAYS=365

# P1 RAG 试点。默认 embedding 可离线复现；切换模型时必须使用新的版本号。
EMBEDDING_VERSION=hash-char-2gram-v1
RAG_HYBRID_KEYWORD_WEIGHT=0.45
RAG_HYBRID_VECTOR_WEIGHT=0.55
RAG_EVENT_PILOT_ENABLED=false
RAG_EVENT_PILOT_SAMPLE_RATE=0.05
RAG_EVENT_PILOT_LIMIT=3
RAG_GRAPH_ENABLED=true
RAG_GRAPH_ASSIST_ONLY=false
RAG_GRAPH_TEXT_WEIGHT=0.35
RAG_GRAPH_RELATION_WEIGHT=0.65
RAG_GRAPH_MAX_HOPS=5
GLOBAL_SEARCH_ENABLED=true
KNOWLEDGE_QA_ENABLED=false
KNOWLEDGE_QA_GRAPH_ENABLED=true
KNOWLEDGE_QA_MAX_CONTEXTS=8
KNOWLEDGE_QA_TIMEOUT_SECONDS=30
RETROSPECTIVE_CENTER_ENABLED=true
RETROSPECTIVE_AI_DRAFT_ENABLED=false
RETROSPECTIVE_EXPERIENCE_ENABLED=false
RETROSPECTIVE_AI_TIMEOUT_SECONDS=30
RETROSPECTIVE_MAX_SOURCES=500
RETROSPECTIVE_MAX_EXPORT_BYTES=2097152
# 可挂载为发布流水线生成的只读质量报告；缺失时质量中心返回 503，不伪造数据。
GOLD_QUALITY_REPORT_PATH=analytics/datasets/final-gold-v3-20260826/quality_report.json
# 在线服务只读该冻结清单；TUSHARE_TOKEN 仅供离线构建进程使用，不放在 API 环境。
QUANT_DEFAULT_MARKET_MANIFEST=real_data/quant/akshare-qfq-tushare120-20260830-v1/manifest.json

# local 默认使用受信任请求头。试点/生产改为 jwt，并由密钥管理系统注入强随机密钥。
AUTH_MODE=trusted_headers
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=ai-investment-copilot
AUTH_JWT_AUDIENCE=ai-investment-copilot-api
AUTH_JWT_LEEWAY_SECONDS=30
AUTH_ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=["http://localhost:5173"]

# 规则阈值。变更需记版本，历史结论不得被新阈值覆盖。
RULE_VERSION=rules-v1
RULE_DIVERGENCE_MIN_SUPPORT=1
RULE_DIVERGENCE_MIN_CONFLICT=1
RULE_NEAR_INVALIDATION_RATIO=0.1
RULE_CONSECUTIVE_BREACH_PERIODS=2
RULE_LOW_CONFIDENCE_CUTOFF=0.6
RULE_TREND_MIN_PERIODS=4
RULE_TREND_MAX_PERIODS=8
