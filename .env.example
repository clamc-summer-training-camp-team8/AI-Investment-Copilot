# 复制为 .env 后按本地情况修改。.env 不进 git。

APP_NAME=AI Investment Copilot
ENV=local
DEBUG=true

DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# 模型网关。
# local = 规则实现，适合离线开发与 CI；使用时把模型版本改为 local-rule-v1。
# http  = OpenAI-compatible Chat Completions；当前示例直接配置 DeepSeek V4 Flash。
LLM_PROVIDER=http
LLM_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL_VERSION=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_THINKING_MODE=disabled
LLM_REASONING_EFFORT=low
PROMPT_VERSION=prompts-v1

REDIS_URL=redis://localhost:6379/0
UPLOAD_MAX_BYTES=20971520

# local 默认使用受信任请求头。试点/生产改为 jwt，并由密钥管理系统注入强随机密钥。
AUTH_MODE=trusted_headers
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=ai-investment-copilot
AUTH_JWT_AUDIENCE=ai-investment-copilot-api
AUTH_JWT_LEEWAY_SECONDS=30
CORS_ORIGINS=["http://localhost:5173"]

# 规则阈值。变更需记版本，历史结论不得被新阈值覆盖。
RULE_VERSION=rules-v1
RULE_DIVERGENCE_MIN_SUPPORT=1
RULE_DIVERGENCE_MIN_CONFLICT=1
RULE_NEAR_INVALIDATION_RATIO=0.1
RULE_CONSECUTIVE_BREACH_PERIODS=2
RULE_LOW_CONFIDENCE_CUTOFF=0.6
RULE_TREND_MIN_PERIODS=4
RULE_TREND_MAX_PERIODS=8
