# 复制为 /opt/ai-investment-copilot/deploy/.env.integration，仅保存在 ECS。
# 密码建议使用 32 位以上随机字母数字；放进 URL 前必须进行 URL 编码。

# 镜像由发布工作流写入 release.env；初次本地构建可保留下面的值。
APP_IMAGE=ai-investment-copilot-app:integration
WEB_IMAGE=ai-investment-copilot-web:integration

# 公网域名，例如 integration-invest.example.com。仅本地验证时可写 :8080。
INTEGRATION_SITE_ADDRESS=integration-invest.example.com
ACME_EMAIL=platform-owner@example.com
# 裸 IP 临时入口填写 internal；正式域名填写 ACME 联系邮箱。
INTEGRATION_TLS_ARGUMENT=platform-owner@example.com
# 产品内登录 JWT 签名密钥；不是成员密码，至少 32 字节且不得提交仓库。
AUTH_JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_ALPHANUMERIC_CHARACTERS

POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql+psycopg://copilot:REPLACE_WITH_URLENCODED_PASSWORD@postgres:5432/copilot

REDIS_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URLENCODED_PASSWORD@redis:6379/0

MINIO_ROOT_USER=copilot-integration
MINIO_ROOT_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OBJECT_STORE_BUCKET=copilot-documents

# Pydantic list 使用 JSON 格式。必须与实际 HTTPS 域名一致。
CORS_ORIGINS=["https://integration-invest.example.com"]

# 默认仍使用本地规则模型，确保投研材料不外发。接入模型网关时再显式修改。
LLM_PROVIDER=local
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL_VERSION=local-rule-v1
GLOBAL_SEARCH_ENABLED=true
KNOWLEDGE_QA_ENABLED=false
KNOWLEDGE_QA_GRAPH_ENABLED=true
KNOWLEDGE_QA_MAX_CONTEXTS=8
KNOWLEDGE_QA_TIMEOUT_SECONDS=30
RETROSPECTIVE_CENTER_ENABLED=false
RETROSPECTIVE_AI_DRAFT_ENABLED=false
RETROSPECTIVE_EXPERIENCE_ENABLED=false
RETROSPECTIVE_AI_TIMEOUT_SECONDS=30
RETROSPECTIVE_MAX_SOURCES=500
RETROSPECTIVE_MAX_EXPORT_BYTES=2097152

# 只在候选已登记并完成灰度验收后切换；回滚时恢复旧清单路径并重建 api/worker。
QUANT_DEFAULT_MARKET_MANIFEST=/app/real_data/quant/akshare-qfq-tushare120-20260830-v1/manifest.json
