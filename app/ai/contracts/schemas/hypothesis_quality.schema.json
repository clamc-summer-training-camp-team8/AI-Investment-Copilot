{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["thesis_id", "summary", "results", "requires_human_review", "confidence", "model_version", "prompt_version", "generated_at", "ai_status"],
  "additionalProperties": false,
  "properties": {
    "thesis_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "logic_dimension", "duplicate_with", "crosses_with", "quality_warning"],
        "additionalProperties": false,
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "logic_dimension": {"type": "string", "minLength": 1},
          "duplicate_with": {"type": "array", "items": {"type": "string"}},
          "crosses_with": {"type": "array", "items": {"type": "string"}},
          "quality_warning": {"type": "string"}
        }
      }
    },
    "requires_human_review": {"type": "boolean", "const": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model_version": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "ai_status": {"type": "string", "enum": ["候选", "低置信", "解析失败"]}
  }
}
