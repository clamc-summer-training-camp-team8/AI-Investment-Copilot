{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-investment-copilot/app-ai/contracts/metric_recommend.schema.json",
  "title": "MetricRecommend",
  "type": "object",
  "required": ["security_id", "hypothesis_id", "catalog_version", "recommendations", "unmatched_concepts", "requires_human_review", "model_version", "prompt_version", "generated_at", "ai_status"],
  "additionalProperties": false,
  "properties": {
    "security_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "catalog_version": {"type": "string", "minLength": 1},
    "recommendations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["metric_id", "metric_version", "metric_name", "relation_type", "rationale", "expected_direction", "observation_frequency", "availability_grade", "source_ids", "threshold_policy", "confidence"],
        "additionalProperties": false,
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "metric_version": {"type": "string", "minLength": 1},
          "metric_name": {"type": "string", "minLength": 1},
          "relation_type": {"type": "string", "enum": ["直接指标", "代理指标"]},
          "rationale": {"type": "string", "minLength": 1},
          "expected_direction": {"type": ["string", "null"], "enum": ["越高越好", "越低越好", "不低于阈值", "不高于阈值", null]},
          "observation_frequency": {"type": "string", "minLength": 1},
          "availability_grade": {"type": "string", "enum": ["A", "B", "C", "D"]},
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "threshold_policy": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "unmatched_concepts": {"type": "array", "items": {"type": "string"}},
    "requires_human_review": {"const": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "model_version": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "ai_status": {"type": "string", "enum": ["候选", "低置信", "解析失败"]}
  }
}
