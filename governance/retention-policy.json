{
  "schema_version": "governed-asset-retention-v1",
  "category_policies": {
    "graph_snapshot": {
      "minimum_retention_days": 730,
      "minimum_versions": 2,
      "deletion_gate": "不得删除任何被 evidence.retrieval_trace、盲测报告或启用决策引用的快照；到期后仍需数据负责人审批。"
    },
    "embedding": {
      "minimum_retention_days": 730,
      "minimum_versions": 2,
      "deletion_gate": "至少保留当前和上一 embedding 版本；被 ingestion_run 或评测报告引用的版本永久保留其规格与哈希。"
    },
    "vocabulary": {
      "minimum_retention_days": 3650,
      "minimum_versions": 2,
      "deletion_gate": "词表版本只追加；被 Graph Snapshot 引用的版本不得原地修改或删除。"
    },
    "gold_report": {
      "minimum_retention_days": 3650,
      "minimum_versions": 1,
      "deletion_gate": "正式盲标、金标、唯一一次评测回执和启用决策永久保留，不得用揭盲回归覆盖。"
    },
    "market_data": {
      "minimum_retention_days": 3650,
      "minimum_versions": 2,
      "deletion_gate": "被 quant_backtest_run 引用的行情、交易日历、公司行动登记簿和清单永久保留；新版本只能追加，禁止覆盖旧哈希。"
    }
  },
  "asset_sets": [
    {
